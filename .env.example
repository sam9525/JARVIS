# Copy to .env (gitignored) and fill in. Main loads this at startup.

# ElevenLabs. Absent = the cloud voice is off and speech falls back to the
# browser's speechSynthesis.
ELEVENLABS_API_KEY=

# Skips the vault folder picker on first launch.
VAULT_PATH=

# Hook listener port. The forwarder and the MCP server read this from their own
# environment, not from here — change it in both places or leave it alone.
JARVIS_PORT=4599
